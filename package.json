{
  "name": "dsh-collaborator",
  "version": "0.1.5",
  "description": "DSH 协作导航：理解任务与知识缺口，主动补充信息、形成判断，并以最直接的路径推进成果。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": ["src/", "prompts/", "examples/", "tests/", "cordis.patch.yml", "README.md"],
  "scripts": {
    "check": "node --check src/index.js && node --check src/state.js && node --check src/interaction.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "collaboration", "task-navigation"],
  "license": "UNLICENSED"
}
